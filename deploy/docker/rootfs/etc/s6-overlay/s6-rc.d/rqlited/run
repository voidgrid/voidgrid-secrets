#!/command/with-contenv sh
# Single-node rqlite, per the project's architecture decision: a Go-native
# SQL-over-HTTP service on SQLite + Raft, run as a single node for now with
# room to add replicas later without a data model change. -fk enforces
# the schema's foreign keys (REFERENCES), which SQLite ignores by default.
mkdir -p "${RQLITE_DATA_DIR:-/data/rqlite}"
exec rqlited \
    -fk \
    -http-addr 127.0.0.1:4001 \
    -raft-addr 127.0.0.1:4002 \
    "${RQLITE_DATA_DIR:-/data/rqlite}"
