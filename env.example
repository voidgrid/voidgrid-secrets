# Settings for the live tests only (`make live-test`): tests that hit a
# real external service, behind a build tag, never part of `make test` or
# the image build. Copy to `.env` at the repo root and fill in real
# values; `.env` is never committed. Anything left as CHANGEME makes the
# live tests skip with a banner instead of failing.
#
# A real OIDC provider (e.g. Pocket ID), registered with this deployment
# as a client. The live test runs discovery against the issuer and checks
# the sign-in redirect it produces; it doesn't need the client secret.

# Issuer URL, exactly as the provider advertises it.
LIVE_OIDC_ISSUER=CHANGEME
LIVE_OIDC_CLIENT_ID=CHANGEME
# The callback URL registered with the provider, e.g.
# https://secrets.example.com/login/oidc/callback
LIVE_OIDC_REDIRECT_URI=CHANGEME
