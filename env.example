# Credentials for "live" tests only (tests that hit a real external
# service, behind a build tag - never the regular `make test` suite).
# Copy to `.env` at the repo root and fill in real values; `.env` is
# never committed.
#
# Currently: a real OIDC identity provider, for testing
# internal/auth/oidc against something other than a bad-issuer error
# case (the only thing testable without one). Leave any variable as
# CHANGEME to have the live test skip itself with a loud banner instead
# of failing.

LIVE_OIDC_ISSUER=CHANGEME
LIVE_OIDC_CLIENT_ID=CHANGEME
LIVE_OIDC_CLIENT_SECRET=CHANGEME
LIVE_OIDC_REDIRECT_URI=CHANGEME
